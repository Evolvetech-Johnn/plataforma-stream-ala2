# Renomeie para .env e troque todos os valores antes de subir o ambiente.
SITE_DOMAIN=transmissao.exemplo.org
ACME_EMAIL=tecnologia@exemplo.org
POSTGRES_DB=transmissao
POSTGRES_USER=app_transmissao
POSTGRES_PASSWORD=SUBSTITUIR_SENHA_FORTE_SEM_CARACTERES_ESPECIAIS
# SRT exige passphrase com 10 a 79 caracteres; gere strings hexadecimais fortes.
SRT_PUBLISH_PASSPHRASE=SUBSTITUIR_32_CARACTERES_HEX_PUBLICACAO
SRT_READ_PASSPHRASE=SUBSTITUIR_32_CARACTERES_HEX_LEITURA
